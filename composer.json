{
    "name": "tizbiz/server",
    "description": "TizBiz server — Yii2 advanced: frontend + backend + api + tenant + console + common",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.51",
        "firebase/php-jwt": "^6.10"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "api\\": "api/",
            "console\\": "console/",
            "frontend\\": "frontend/",
            "backend\\": "backend/",
            "tenant\\": "tenant/"
        },
        "exclude-from-classmap": [
            "/console/migrations/"
        ]
    }
}
